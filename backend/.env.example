# Desenvolvimento local; não colocar estas variáveis no frontend.
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=connect2work
DB_USER=c2w_api
# Preencha somente em .env. Não envie senha no chat ou commit.
DB_PASSWORD=
# Cookie seguro somente com HTTPS. HTTP local é o padrão desta etapa.
AUTH_HTTPS=false
AUTH_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cloudinary: credenciais somente no backend/.env; nunca usar prefixo VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Namespace exclusivo por ambiente. Produção rejeita connect2work/local.
CLOUDINARY_NAMESPACE=connect2work/local
