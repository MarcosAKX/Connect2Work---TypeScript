{
  "name": "connect2work-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "cleanup:imagens": "npm run build && node --env-file=.env dist/src/limpar-imagens.js",
    "check:catalogo-admin": "npm run build && node --env-file=.env dist/src/check-catalogo-administrativo.js",
    "check:cloudinary": "npm run build && node --env-file=.env dist/src/check-cloudinary-imagens.js",
    "check:admin-usuarios": "npm run build && node --env-file=.env dist/src/check-admin-usuarios.js",
    "check:salas": "npm run build && node --env-file=.env dist/src/check-salas.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.spec.js",
    "start": "node --env-file=.env dist/src/main.js",
    "dev": "npm run build && npm start",
    "check:unidades": "npm run build && node --env-file=.env dist/src/check-unidades.js",
    "check:authentication": "npm run build && node --env-file=.env dist/src/check-authentication.js",
    "check:registration": "npm run build && node --env-file=.env dist/src/check-registration.js",
    "check:database": "npm run build && node --env-file=.env dist/src/check-database.js",
    "check:agendamentos-admin": "npm run build && node --env-file=.env dist/src/check-agendamentos-admin.js",
    "check:tarefas": "npm run build && node --env-file=.env dist/src/check-tarefas.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "mysql2": "3.24.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/multer": "2.3.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
